---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Mayank Manjul — Principal Gameplay Engineer', description = 'Principal gameplay engineer with 12+ years shipping Unreal Engine 5 and Unity games: runtime systems, locomotion and multiplayer netcode.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#0b0d10" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <div class="wrap bar">
      <a href="/" class="brand">MAYANK<span>_</span>MANJUL</a>
      <nav aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/lab/">Lab</a>
        <a href="/#experience">Experience</a>
        <a href="/#contact">Contact</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="wrap foot">
    <span>© {new Date().getFullYear()} Mayank Manjul</span>
    <span class="hint">press <kbd>~</kbd> for the console</span>
  </footer>
  <dialog id="console" aria-label="Developer console">
    <pre id="console-out">MM_ENGINE console. Type `help`.</pre>
    <form method="dialog" id="console-form"><span>&gt;</span><input id="console-in" autocomplete="off" aria-label="Command" /></form>
  </dialog>
  <script>
    const dlg = document.getElementById('console') as HTMLDialogElement;
    const out = document.getElementById('console-out')!;
    const input = document.getElementById('console-in') as HTMLInputElement;
    const cmds: Record<string, string | (() => string)> = {
      help: 'help, work, lab, resume, contact, clear, exit',
      work: () => { location.href = '/#work'; return 'jumping to work…'; },
      lab: () => { location.href = '/lab/'; return 'loading lab…'; },
      resume: () => { open('/resume.pdf'); return 'opening resume.pdf'; },
      contact: 'mayankmanjul@live.com · linkedin.com/in/mayankmanjul',
      clear: () => { out.textContent = ''; return ''; },
      exit: () => { dlg.close(); return ''; },
    };
    addEventListener('keydown', (e) => {
      if (e.key === '`' || e.key === '~') {
        if ((e.target as HTMLElement).tagName === 'INPUT' && !dlg.open) return;
        e.preventDefault(); dlg.open ? dlg.close() : (dlg.showModal(), input.focus());
      }
    });
    document.getElementById('console-form')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const c = input.value.trim().toLowerCase(); input.value = '';
      const r = cmds[c]; const res = r === undefined ? `unknown command: ${c}` : typeof r === 'function' ? r() : r;
      out.textContent += `\n> ${c}${res ? '\n' + res : ''}`; out.scrollTop = out.scrollHeight;
    });
  </script>
</body>
</html>
<style>
  .top { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; justify-content: space-between; align-items: center; height: 60px; }
  .brand { font: 700 14px var(--mono); letter-spacing: .12em; text-decoration: none; }
  .brand span { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  nav { display: flex; gap: 20px; }
  nav a { font: 13px var(--mono); color: var(--muted); text-decoration: none; }
  nav a:hover { color: var(--text); }
  .foot { display: flex; justify-content: space-between; padding: 32px 20px 48px; color: var(--muted); font: 13px var(--mono); border-top: 1px solid var(--line); }
  kbd { border: 1px solid var(--line); border-radius: 3px; padding: 0 5px; }
  dialog { width: min(720px, 92vw); background: #05080a; color: #9ff3c6; border: 1px solid var(--accent); border-radius: 8px; font: 14px var(--mono); padding: 16px; }
  dialog::backdrop { background: #000a; }
  #console-out { max-height: 40vh; overflow: auto; margin: 0 0 8px; white-space: pre-wrap; }
  #console-form { display: flex; gap: 8px; }
  #console-in { flex: 1; background: none; border: 0; color: inherit; font: inherit; outline: none; }
  @media (max-width: 600px) { nav { gap: 12px; } nav a:nth-child(3) { display: none; } .hint { display: none; } }
</style>
